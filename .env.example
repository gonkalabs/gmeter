# Copy this file to .env and fill in provider keys locally.
# Never commit real API keys.
OPENBROKER_API_KEY=
OPENBROKER_BASE_URL=https://api.openbroker.gonka.gg/v1
GONKA_API_KEY=
GONKA_BASE_URL=https://api.proxy.gonka.gg/v1
GONKAGATE_API_KEY=
GONKAGATE_BASE_URL=https://api.gonkagate.com/v1
MINGLES_API_KEY=
MINGLES_BASE_URL=https://gonka-gateway.mingles.ai/v1
GONKA_API_ORG_API_KEY=
GONKA_API_ORG_BASE_URL=https://api.gonka-api.org/v1
HYPERFUSION_API_KEY=
HYPERFUSION_BASE_URL=https://api.hyperfusion.io/v1
GONKASCAN_API_KEY=
GONKASCAN_BASE_URL=https://api.gonkascan.com/v1
BROKERS_CONFIG_PATH=brokers.json
# BROKERS_CONFIG_JSON={"brokers":[]}
PROBE_INTERVAL_MINUTES=10
LIMITS_INTERVAL_MINUTES=60
MIN_OUTPUT_TOKENS=10000
DEFAULT_MODELS=moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7,deepseek-ai/DeepSeek-V4-Flash-0731
ACTIVE_MODELS=moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7,deepseek-ai/DeepSeek-V4-Flash-0731,zai-org/GLM-5.2-FP8
KNOWN_MODELS=moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7,deepseek-ai/DeepSeek-V4-Flash-0731,zai-org/GLM-5.2-FP8,Qwen/Qwen3-235B-A22B-Instruct-2507-FP8
GONKA_MODELS=moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7,deepseek-ai/DeepSeek-V4-Flash-0731
GONKAGATE_MODELS=moonshotai/kimi-k2.6,minimaxai/minimax-m2.7,deepseek-ai/deepseek-v4-flash-0731,zai-org/glm-5.2-fp8
PUBLIC_READ_ONLY=true
RUN_PROBE_ON_STARTUP=true
RUN_LIMITS_ON_STARTUP=false
AI_SUMMARY_ENABLED=true
AI_SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
AI_SUMMARY_INTERVAL_MINUTES=15
# Optional overrides (default: GONKA_BASE_URL / GONKA_API_KEY)
# AI_SUMMARY_BASE_URL=https://api.proxy.gonka.gg/v1
# AI_SUMMARY_API_KEY=
